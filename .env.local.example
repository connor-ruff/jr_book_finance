# --- App auth (shared password gate) ---
SITE_PASSWORD=changeme
# Used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Snowflake connection ---
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USERNAME=jr_finance_app
SNOWFLAKE_WAREHOUSE=REPORTING_WH
SNOWFLAKE_DATABASE=JR_BOOKS
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=REPORTING_READ

# --- Snowflake key-pair auth: provide EITHER path OR inline key ---
# Option A — file path (best for local dev):
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/you/.snowflake/jr_finance_app.p8

# Option B — inline PEM contents (best for Vercel/etc.; escape newlines as \n):
# SNOWFLAKE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# If your key is encrypted:
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
